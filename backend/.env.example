# ============================================================
# Nayanta AI Backend — Environment Configuration
# Copy this file to .env and fill in the values.
# ============================================================

# Server
PORT=8080
NODE_ENV=development

# Allowed frontend origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Redis (BullMQ) — Upstash connection string for production
REDIS_URL=redis://localhost:6379

# Firebase / Firestore
FIREBASE_PROJECT_ID=nayanta-ai-demo
GCP_PROJECT_ID=nayanta-ai-demo

# Google Cloud Storage
GCS_BUCKET_NAME=nayanta-ai-documents

# Google Secret Manager
# In production, FIREBASE_SERVICE_ACCOUNT_KEY is fetched from Secret Manager.
# In development, set the path to a local service account JSON file:
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Qdrant (Person 3 — vector search)
QDRANT_URL=http://localhost:6333

# Gemini API (Person 2 — agent inference)
GEMINI_API_KEY=
