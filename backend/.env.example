# ============================================================
# Nayanta AI Backend — Environment Configuration
# Copy this file to .env and fill in the values.
# ============================================================

# Server
PORT=8080
NODE_ENV=development

# Allowed frontend origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Redis (BullMQ) — Upstash connection string for production
REDIS_URL=redis://localhost:6379

# Firebase / Firestore
FIREBASE_PROJECT_ID=nayanta-ai-demo
GCP_PROJECT_ID=nayanta-ai-demo

# Google Cloud Storage
GCS_BUCKET_NAME=nayanta-ai-documents

# Google Secret Manager
# In production, FIREBASE_SERVICE_ACCOUNT_KEY is fetched from Secret Manager.
# In development, set the path to a local service account JSON file:
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Qdrant (Person 3 — vector search)
QDRANT_URL=http://localhost:6333

# Gemini API (Person 2 — agent inference)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-1.5-flash
GEMINI_VISION_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Twilio (WhatsApp notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Exotel (SMS/Voice fallback)
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SID=
EXOTEL_CALLER_ID=

# DigiLocker integration (set to 'live' in production)
DIGILOCKER_MODE=mock
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=

# CPGRAMS integration (set to 'live' in production)
CPGRAMS_MODE=mock
CPGRAMS_API_URL=
CPGRAMS_API_KEY=

# Feature flags
WHATSAPP_ENABLED=false
SMS_FALLBACK_ENABLED=true
